{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iyzi Reader",
  "version": "1.0.0",
  "identifier": "com.iyzi.reader",
  "build": {
    "frontendDist": "../dist-tauri",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "bun run dev"
  },
  "app": {
    "windows": [
      { "title": "Iyzi Reader", "width": 1200, "height": 820, "minWidth": 360, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
